{
  "name": "dsh-documents",
  "version": "1.0.0",
  "description": "Session-linked document library for DSH Desktop: in-app Markdown viewer, zoom, provenance and edit history.",
  "type": "module",
  "license": "MIT",
  "author": "aerfaman",
  "homepage": "https://github.com/aerfaman/dsh-documents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aerfaman/dsh-documents.git"
  },
  "bugs": {
    "url": "https://github.com/aerfaman/dsh-documents/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "documents",
    "document-library",
    "markdown"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node scripts/verify.mjs",
    "prepack": "npm run check",
    "pack:dry": "npm pack --dry-run"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
